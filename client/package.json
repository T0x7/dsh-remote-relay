  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T0x7/dsh-remote-relay.git",
    "directory": "client"
  },
  "keywords": ["dsh", "deepseek-harness", "remote-control", "tunnel", "websocket", "cli"],
  "files": ["dist", "README.md"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dsh-remote-client": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
