# dsh-remote-relay 客户端配置模板 —— 也可用 CLI flag 传（--relay-url / --psk）。

# [必填] relay 服务端地址（origin，含协议）。
DSH_REMOTE_RELAY_URL=https://relay.example.com

# [必填] 隧道共享密钥，与服务端 RELAY_PSK 一致。生成：openssl rand -hex 32
DSH_REMOTE_PSK=

# 本地 dsh 引擎绑定（默认 127.0.0.1:3080）。
# DSH_BIND_HOST=127.0.0.1
# DSH_BIND_PORT=3080

# [dsh 部署选填] 引擎 X-App-Token（等价引擎进程内 DSH_BIND_TOKEN）——设了才会
# 走引擎 cookie mint（/auth 着陆）；未启用引擎 lockdown 时可留空。
# DSH_BIND_TOKEN=

# 配对落盘目录（默认 ~/.dsh-remote-relay，chmod 600）。
# DSH_REMOTE_DATA_ROOT=
