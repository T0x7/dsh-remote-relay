# Flutter / Dart build output
build/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# Pub cache, the vendored Flutter SDK (.toolchain/flutter-env.sh) and the
# Gradle distribution/caches under .toolchain/gradle-home — all large, and the
# Flutter SDK is a nested git repository.
.pub-cache/
# D-082: 本地开发工具链整体不入库——它是本机的一次性调试探针
# （硬编码个人家目录路径，对外部用户零价值）。有长期价值的检查脚本已
# 移入仓库根的 scripts/（如 check-arb-keys.py）。
.toolchain/
.toolchain/flutter/
.toolchain/gradle-home/

# The debug APK is 213 MB — never a repo artifact.
*.apk
*.aab

# Scratch screenshots from debugging sessions.
*.png

# …except the golden baselines. `golden_test.dart` pins three design
# artifacts, and they were being swept up by the `*.png` above — so they were
# never tracked, and `machines list` failed on any machine that hadn't run
# `--update-goldens` locally. A test whose expected value lives only in the
# developer's home directory is not a test. Regenerate with
# `flutter test --update-goldens`.
!test/goldens/*.png

# Android/iOS host scaffolding generated by `flutter create`
app/android/.gradle/
app/android/local.properties
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh

# E2E evidence: screenshots and pulled frames are per-run artifacts, kept
# locally for the record but not versioned (app/.e2e/ can reach 30+ MB).
.e2e/

# Toolchain scratch
.toolchain/*.png
.toolchain/ocr
.toolchain/__pycache__/
.toolchain/tmp/
/android/.kotlin/
