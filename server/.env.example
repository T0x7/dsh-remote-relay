# dsh-remote-relay 部署配置模板 —— cp .env.example .env 后填写。
# 完整变量说明见 README「Configuration」。

# [必填] dsh→relay 隧道共享密钥。生成：openssl rand -hex 32
# 与插件侧 remote.psk / dsh 启动环境保持一致；relay 对默认值 fail-closed 拒启。
RELAY_PSK=

# [必填] relay 的公网权威（裸 host 或 host:port，无协议无路径）。
# 必须与 dsh 启动参数 --trusted-host 完全一致——relay 把它钉进每个转发请求
# 的 Host 头，dsh fence 据此放行基础 /api、继续封锁 16 个 PRIVILEGED 方法。
RELAY_PUBLIC_HOST=

# dsh 引擎地址。compose 内默认走宿主机（dsh 跑在宿主）；relay 与 dsh 同机时不变。
DSH_UPSTREAM=http://host.docker.internal:3080

# 信任的 X-Forwarded-For 跳点（nginx 容器固定 IP）。改子网需同步。
RELAY_TRUST_PROXY=172.28.0.10

# 会话生命周期：tunnel 断线宽限（秒）与配对绝对寿命上限（秒，默认 30 天）。
RELAY_SESSION_GRACE_SEC=600
RELAY_SESSION_MAX_AGE_SEC=2592000

# 额外 WS 桥接路径（逗号分隔，绝对路径）。dsh 核心事件流（/api/events.*、
# /api/remote.mux）默认已桥接；这里只列插件自有的实时 WS（如行情流），
# 不列则其 upgrade 会被拒。例：RELAY_WS_BRIDGE_PATHS=/my-plugin/realtime
RELAY_WS_BRIDGE_PATHS=

# watchdog：巡检间隔（秒）与告警 webhook（Bark/ntfy/自建均可，收 JSON POST）。
WATCHDOG_INTERVAL_SEC=300
RELAY_ALERT_WEBHOOK_URL=

# 日志级别（pino，JSON 到 stdout，docker logs 收集轮转）。
LOG_LEVEL=info
