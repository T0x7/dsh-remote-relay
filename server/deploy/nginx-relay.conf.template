# nginx TLS 前置模板（docker-compose `tls` profile）。
# 官方 nginx 镜像启动时对 /etc/nginx/templates/*.template 做 envsubst（只替换
# 环境里已有的变量，$host/$remote_addr 等 nginx 内建变量原样保留）。
#
# 证书挂载在 ./deploy/certs/{fullchain,privkey}.pem（自签见 gen-selfsigned.sh；
# 生产请用 certbot 签发后拷入或改用宿主机 nginx）。

server {
    listen 80;
    server_name ${RELAY_PUBLIC_HOST};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${RELAY_PUBLIC_HOST};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 手机 dsh SPA + WS 事件流都从这里走
    location / {
        proxy_pass http://relay:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        # 真实客户端 IP 透传——relay 只信任本跳点（RELAY_TRUST_PROXY），
        # 限流键与审计 IP 都取自这里；缺失则全部流量按 nginx IP 计数。
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # WS 事件流长连接
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
